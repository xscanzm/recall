{
  "name": "recall",
  "version": "0.1.0",
  "description": "回声 Recall - 主动型桌面上下文记忆助理",
  "main": "dist/main/app.js",
  "author": "Recall Contributors",
  "license": "BUSL-1.1",
  "private": false,
  "homepage": "https://github.com/xscanzm/recall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xscanzm/recall.git"
  },
  "bugs": {
    "url": "https://github.com/xscanzm/recall/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer -c blue,green \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json && wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.node.json && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder --win",
    "typecheck:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "backfill:memory": "python scripts/backfill_memory_objects.py",
    "smoke:memory": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-memory-pipeline.js",
    "smoke:renderer": "electron scripts/smoke-renderer-memory-ui.js"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.3.0",
    "keytar": "^7.9.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.recall.app",
    "productName": "Recall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/shared/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "resources/icons/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "Recall-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Recall"
    }
  }
}
