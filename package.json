{
  "name": "recall",
  "version": "0.5.8",
  "description": "回声 Recall - 主动型桌面上下文记忆助理",
  "main": "dist/main/app.js",
  "author": "Recall Contributors",
  "license": "BUSL-1.1",
  "private": false,
  "homepage": "https://github.com/xscanzm/recall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xscanzm/recall.git"
  },
  "bugs": {
    "url": "https://github.com/xscanzm/recall/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer -c blue,green \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json && node scripts/copy-assets.js && wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:main": "node -e \"const fs=require('fs'); for (const target of ['dist/main','dist/shared','dist/.tsbuildinfo.prod']) fs.rmSync(target,{recursive:true,force:true})\" && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.node.prod.json && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "build:ocr-worker": "node scripts/build-ocr-worker.js",
    "build:ocr-worker:win": "pwsh -NoProfile -File scripts/build-rapidocr-worker.ps1",
    "build:ocr-worker:mac": "bash scripts/build-rapidocr-worker.sh",
    "verify:ocr-worker": "node scripts/verify-rapidocr-worker.js",
    "verify:embedding-worker": "python scripts/verify-embedding-worker.py",
    "verify:packaged-embedding-worker": "python scripts/verify-embedding-worker.py --target exe --win-unpacked release/win-unpacked",
    "eval:retrieval": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/eval-retrieval.js",
    "profile:ocr-worker": "node scripts/profile-rapidocr-worker.js",
    "package": "npm run build:ocr-worker && npm run verify:embedding-worker -- --target exe && npm run build && electron-builder --win && npm run verify:packaged-embedding-worker",
    "package:mac": "npm run build:ocr-worker:mac && npm run build && npx electron-builder --mac",
    "typecheck:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "test:sqlite": "npm run rebuild:electron && npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-sqlite-integration.js",
    "test:e2e": "npm run build && playwright test",
    "backfill:memory": "python scripts/backfill_memory_objects.py",
    "smoke:memory": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-memory-pipeline.js",
    "smoke:renderer": "electron scripts/smoke-renderer-memory-ui.js"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.3.0",
    "keytar": "7.9.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.46.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "dmg-license": "1.0.11"
  },
  "build": {
    "appId": "com.recall.app",
    "productName": "Recall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/shared/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/__tests__/**/*",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*",
          "!ocr/**/*"
        ]
      },
      {
        "from": "resources/ocr/rapidocr-worker",
        "to": "ocr/rapidocr-worker"
      }
    ],
    "icon": "resources/icons/icon.ico",
    "afterSign": "build/after-sign-mac.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "Recall-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Recall-${version}-mac-${arch}.${ext}",
      "icon": "resources/icons/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Recall 需要辅助功能权限以识别当前活动应用，用于构建您的活动记忆。",
        "NSScreenCaptureUsageDescription": "Recall 需要屏幕录制权限以捕获当前活动窗口，用于构建您的活动记忆。所有数据仅本地存储。",
        "NSCameraUsageDescription": "Recall 不使用摄像头，此条目仅为系统兼容性保留。",
        "LSMinimumSystemVersion": "12.0.0"
      }
    },
    "dmg": {
      "title": "Recall ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Recall"
    }
  }
}
